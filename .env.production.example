# Copie para .env.production; não versione os valores reais.
SITE_DOMAIN=erp.suaempresa.com.br
POSTGRES_DB=gestoria
POSTGRES_USER=gestoria
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(36))"
# Use apenas caracteres URL-safe (letras, números, hífen e sublinhado).
POSTGRES_PASSWORD=
# Gere com: python scripts/configure_security.py --env .env.production
OPERATION_SIGNING_KEYS=
OPERATION_ACTIVE_KEY_ID=v1

# Copiloto: configuração exclusiva da API; nunca usar prefixos VITE_/EXPO_PUBLIC_.
# Apenas o provedor determinístico local está implementado; não faz chamadas externas.
COPILOT_PROVIDER=local
COPILOT_API_KEY=
COPILOT_RATE_LIMIT_MAX_REQUESTS=30
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60
